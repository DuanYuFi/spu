load("//bazel:spu.bzl", "spu_cc_library", "spu_cc_test")

package(default_visibility = ["//visibility:public"])

alias(
    name = "boolean",
    actual = ":state",
)

spu_cc_library(
    name = "replicated",
    srcs = ["replicated.cc"],
    hdrs = ["replicated.h"],
    deps = [
        ":type",
        "//libspu/core:parallel_utils",
        "//libspu/mpc/common:prg_state",
    ],
)

spu_cc_library(
    name = "state",
    # Kernels and their checked session refer to each other. Keep the separate
    # source files in one library to avoid cyclic implementation dependencies.
    srcs = [
        "arithmetic.cc",
        "boolean.cc",
        "conversion.cc",
        "correlated_randomness.cc",
        "state.cc",
        "ring.cc",
        "ring_truncation.cc",
    ],
    hdrs = [
        "arithmetic.h",
        "boolean.h",
        "conversion.h",
        "correlated_randomness.h",
        "state.h",
        "ring.h",
        "ring_arithmetic.h",
        "ring_truncation.h",
    ],
    deps = [
        ":replicated",
        ":type",
        "//libspu/core:parallel_utils",
        "//libspu/mpc:kernel",
        "//libspu/mpc:protocol_session",
        "//libspu/mpc/common:prg_state",
        "//libspu/mpc/common:pv2k",
        "@yacl//yacl/crypto/hash:blake3",
        "@yacl//yacl/crypto/rand",
        "@yacl//yacl/crypto/tools:prg",
        "@yacl//yacl/link/algorithm:allgather",
    ],
)

spu_cc_library(
    name = "protocol",
    srcs = ["protocol.cc"],
    hdrs = ["protocol.h"],
    deps = [
        ":state",
        "//libspu/mpc:kernel",
        "//libspu/mpc/standard_shape:protocol",
    ],
)

spu_cc_test(
    name = "protocol_test",
    srcs = ["protocol_test.cc"],
    deps = [
        ":io",
        ":protocol",
        ":replicated",
        "//libspu/mpc:api",
        "//libspu/mpc/utils:simulate",
    ],
)

spu_cc_library(
    name = "field",
    hdrs = ["field.h"],
)

spu_cc_library(
    name = "type",
    srcs = ["type.cc"],
    hdrs = ["type.h", "ring_type.h", "ring_math.h"],
    deps = [
        ":field",
        "//libspu/core:type",
        "//libspu/mpc/common:pv2k",
    ],
)

spu_cc_library(
    name = "io",
    srcs = ["io.cc"],
    hdrs = ["io.h"],
    deps = [
        ":type",
        "//libspu/core:config",
        "//libspu/mpc:io_interface",
        "//libspu/mpc/common:pv2k",
        "@yacl//yacl/crypto/rand",
    ],
)

spu_cc_test(
    name = "io_test",
    srcs = ["io_test.cc"],
    deps = [
        ":io",
        "//libspu/core:value",
    ],
)

spu_cc_test(
    name = "boolean_test",
    srcs = ["boolean_test.cc"],
    deps = [
        ":boolean",
        ":io",
        ":protocol",
        ":state",
        "//libspu/mpc:api",
        "//libspu/mpc/common:pv2k",
        "//libspu/mpc/utils:simulate",
    ],
)

spu_cc_test(
    name = "ring_truncation_test",
    srcs = ["ring_truncation_test.cc"],
    deps = [
        ":io",
        ":protocol",
        ":state",
        "//libspu/mpc:api",
        "//libspu/mpc/aby3:protocol",
        "//libspu/mpc/aby3:io",
        "//libspu/mpc/utils:simulate",
    ],
)

spu_cc_test(
    name = "ring_test",
    srcs = ["ring_test.cc"],
    deps = [
        ":io",
        ":protocol",
        ":state",
        "@yacl//yacl/crypto/hash:blake3",
        "//libspu/mpc:api",
        "//libspu/mpc/common:pv2k",
        "//libspu/mpc/utils:simulate",
    ],
)
