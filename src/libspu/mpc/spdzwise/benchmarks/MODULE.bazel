module(name = "malicious_ppml_benchmark")

bazel_dep(name = "spulib")
local_path_override(
    module_name = "spulib",
    path = "../../../..",
)

# Expose labels used by the imported SPU build configuration and C++ toolchain.
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_cc", version = "0.0.12")
bazel_dep(name = "rules_cuda", version = "0.2.3")
bazel_dep(name = "rules_foreign_cc", version = "0.15.0")

# Bzlmod applies overrides only from the root module. The local patch labels
# point to symlinks to the existing SPU patches.
single_version_override(
    module_name = "grpc",
    patch_strip = 1,
    patches = ["//patches:grpc.patch"],
    version = "1.74.1",
)

single_version_override(
    module_name = "rules_foreign_cc",
    patch_strip = 1,
    patches = ["//patches:rules_foreign_cc.patch"],
    version = "0.15.0",
)

single_version_override(
    module_name = "openssl",
    version = "3.3.2.bcr.1",
)
