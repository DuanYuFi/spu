+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#pragma once
+
+#include <functional>
+#include <memory>
+
+#include "yacl/base/buffer.h"
+
+#include "libspu/mpc/common/prg_state.h"
+#include "libspu/mpc/spdzwise/type.h"
+
+namespace spu::mpc::spdzwise {
+
+// Counts packed 64-bit triples (including one zero-extended partial word),
+// not the number of active bit lanes. Small nonempty batches are unsupported.
+size_t AbflBucketSize(size_t words);
+
+// Owned by the checked session. No application reveal API is exposed.
+class BooleanState {
+  friend class BooleanTestAccess;
+  using Triple = std::array<RepShare, 3>;
+  // Default-initialized storage: parallel writers touch each element once.
+  // Unlike vector(size), this does not zero large buffers on the caller thread.
+  struct TriplePool {
+    size_t count;
+    std::unique_ptr<Triple[]> storage;
+    explicit TriplePool(size_t n) : count(n), storage(new Triple[n]) {}
+    size_t size() const { return count; }
+    Triple& operator[](size_t i) { return storage[i]; }
+    const Triple& operator[](size_t i) const { return storage[i]; }
+  };
+  std::shared_ptr<yacl::link::Context> link_;
+  std::function<std::string(std::string_view)> tag_;
+  PrgState random_prg_, mask_prg_;
+  std::vector<Triple> pending_;  // full words packed from narrow inputs
+  // Full-width calls own contiguous snapshots; adding a call never relocates
+  // the records of previous calls. Verification traverses blocks directly.
+  std::vector<std::vector<Triple>> pending_batches_;
+  Triple overflow_{};
+  size_t overflow_bits_ = 0;
+  size_t bits_ = 0;
+  std::string layout_;
+  uint64_t checks_ = 0;
+
+  // With borrow_local, the local result slot is empty; the caller keeps bytes
+  // alive and reads its local view directly. Peer slots always own their data.
+  std::vector<yacl::Buffer> gather(std::string_view bytes,
+                                   std::string_view name,
+                                   bool borrow_local = false);
+  void agree(std::string_view bytes);
+  void requireAll(bool valid, std::string_view reason);
+  std::vector<RepShare> andRaw(const std::vector<RepShare>& x,
+                               const std::vector<RepShare>& y);
+  std::vector<uint64_t> open(absl::Span<const RepShare> shares);
+  void open(absl::Span<const RepShare> shares, absl::Span<uint64_t> result);
+  void reservePending(size_t full_words);
+  void append(const std::vector<RepShare>& a, const std::vector<RepShare>& b,
+              const std::vector<RepShare>& c, size_t width);
+  TriplePool generate(size_t words);
+  void checkPrepared(TriplePool pool);
+  std::vector<size_t> permutation(size_t count);
+  static std::vector<size_t> shuffledIndices(size_t count, uint128_t seed);
+
+ public:
+  BooleanState(std::shared_ptr<yacl::link::Context> link,
+               std::function<std::string(std::string_view)> tag);
+  size_t pendingBits() const { return bits_; }
+  uint64_t checks() const { return checks_; }
+  void checkCopies(const std::vector<RepShare>& shares);
+  NdArrayRef andBB(const NdArrayRef& x, const NdArrayRef& y,
+                   const std::string& session);
+  void check();
+};
+
+}  // namespace spu::mpc::spdzwise
diff --git a/src/libspu/mpc/spdzwise/benchmarks/binary_bench.cc b/src/libspu/mpc/spdzwise/benchmarks/binary_bench.cc
new file mode 100644
index 00000000..ab886d33
--- /dev/null
+++ b/src/libspu/mpc/spdzwise/benchmarks/binary_bench.cc
@@ -0,0 +1,184 @@
+// Copyright 2026 The SPU Authors. All Rights Reserved.
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+// http://www.apache.org/licenses/LICENSE-2.0
+
+#include <chrono>
+#include <condition_variable>
+#include <iomanip>
+#include <iostream>
+#include <mutex>
+
+#include "libspu/mpc/aby3/protocol.h"
+#include "libspu/mpc/aby3/type.h"
+#include "libspu/mpc/api.h"
+#include "libspu/mpc/spdzwise/io.h"
+#include "libspu/mpc/spdzwise/protocol.h"
+#include "libspu/mpc/spdzwise/state.h"
+#include "libspu/mpc/utils/simulate.h"
+
+namespace spu::mpc::spdzwise {
+namespace {
+constexpr int64_t kWidth = 65536;
+constexpr int64_t kDepth = 16;
+constexpr size_t kBits = kWidth * kDepth * 64;
+constexpr int kRepetitions = 7;
+
+// Fully specified reproducible plaintext workload, not cryptographic
+// randomness.
+uint64_t InputWord(uint64_t index) {
+  uint64_t z = index + 0x9e3779b97f4a7c15ULL;
+  z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+  z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+  return z ^ (z >> 31);
+}
+class Barrier {
+  std::mutex mutex_;
+  std::condition_variable cv_;
+  size_t arrived_ = 0, generation_ = 0;
+
+ public:
+  void wait() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    const auto generation = generation_;
+    if (++arrived_ == 3) {
+      arrived_ = 0;
+      ++generation_;
+      cv_.notify_all();
+    } else {
+      cv_.wait(lock, [&] { return generation_ != generation; });
+    }
+  }
+};
+struct Result {
+  double online_ms = 0, verify_ms = 0;
+  size_t online_bytes = 0, verify_bytes = 0;
+  NdArrayRef output;
+};
+
+void Run(bool native_aby3) {
+  SpdzWiseIo io(FM64, 3);
+  std::vector<std::vector<NdArrayRef>> shares;
+  std::vector<uint64_t> expected(kWidth, ~uint64_t{0});
+  for (int64_t layer = 0; layer <= kDepth; ++layer) {
+    NdArrayRef input(makeType<RingTy>(FM64), {kWidth});
+    for (int64_t i = 0; i < kWidth; ++i) {
+      const auto word = InputWord(layer * kWidth + i);
+      input.data<uint64_t>()[i] = word;
+      expected[i] &= word;
+    }
+    shares.push_back(io.toBooleanShares(input, 64));
+  }
+  std::cout
+      << std::fixed << std::setprecision(6)
+      << "protocol,width,depth,word_ands,bit_ands,bucket_size,iteration,rank,"
+         "online_ms,verify_ms,total_ms,online_bytes,verify_bytes,checks\n";
+  for (int iteration = 0; iteration <= kRepetitions; ++iteration) {
+    Barrier barrier;
+    const auto results = utils::simulate(3, [&](const auto& link) {
+      RuntimeConfig config;
+      config.protocol = native_aby3 ? ABY3 : SPDZWISE;
+      config.field = FM64;
+      config.fxp_fraction_bits = 16;
+      SPUContext ctx(config, link);
+      if (native_aby3) {
+        regAby3Protocol(&ctx, link);
+      } else {
+        registerArithmeticPrototype(&ctx, link);
+      }
+      auto* state =
+          native_aby3 ? nullptr : ctx.prot()->getState<SpdzWiseState>();
+      ProtocolRunGuard guard(&ctx);
+      std::vector<Value> inputs;
+      std::vector<std::string> names;
+      for (int64_t layer = 0; layer <= kDepth; ++layer) {
+        // The external XOR shares have the same replicated layout in both
+        // protocols. Only benchmark type adaptation occurs outside timing.
+        auto share = shares[layer][link->Rank()];
+        if (native_aby3) share = share.as(makeType<aby3::BShrTy>(PT_U64, 64));
+        inputs.emplace_back(share, DT_U64);
+        names.push_back(std::to_string(layer));
+      }
+      if (state) {
+        state->begin(ExecutableProto("abfl_c2", names, {"z"}, "benchmark"),
+                     inputs);
+        for (auto& input : inputs) input = import_s(&ctx, input);
+      }
+      Value z = inputs[0];
+      Result result;
+      const auto stats = link->GetStats();
+      auto phase = [&](double& ms, size_t& bytes, auto&& operation) {
+        barrier.wait();
+        const auto before = stats->sent_bytes.load();
+        const auto start = std::chrono::steady_clock::now();
+        operation();
+        ms = std::chrono::duration<double, std::milli>(
+                 std::chrono::steady_clock::now() - start)
+                 .count();
+        bytes = stats->sent_bytes.load() - before;
+      };
+      phase(result.online_ms, result.online_bytes, [&] {
+        for (int64_t layer = 0; layer < kDepth; ++layer) {
+          z = dynDispatch(&ctx, "and_bb", z, inputs[layer + 1]);
+        }
+      });
+      SPU_ENFORCE(result.online_bytes == kWidth * kDepth * sizeof(uint64_t));
+      if (state) {
+        SPU_ENFORCE(state->pendingBooleanBits() == kBits);
+        SPU_ENFORCE(state->booleanChecks() == 0);
+        phase(result.verify_ms, result.verify_bytes,
+              [&] { state->finalize(); });
+        SPU_ENFORCE(state->pendingBooleanBits() == 0 &&
+                    state->booleanChecks() == 1);
+        z.setDtype(DT_U64);
+        const auto before_export = stats->sent_bytes.load();
+        state->prepareOutputs(&ctx, {"z"}, {z});
+        guard.commit();
+        SPU_ENFORCE(stats->sent_bytes.load() == before_export);
+        SPU_ENFORCE(state->booleanChecks() == 1);
+        result.output = state->exportedValue("z").data();
+      } else {
+        result.output = z.data().as(makeType<BInputTy>(link->Rank(), 64));
+        guard.commit();
+      }
+      return result;
+    });
+    std::vector<NdArrayRef> output;
+    for (const auto& result : results) {
+      output.push_back(result.output);
+    }
+    const auto actual = io.fromShares(output);
+    for (int64_t i = 0; i < kWidth; ++i) {
+      SPU_ENFORCE(actual.data<uint64_t>()[i] == expected[i],
+                  "C2 output mismatch at {}", i);
+    }
+    double online_max = 0, verify_max = 0;
+    for (size_t rank = 0; rank < 3; ++rank) {
+      const auto& r = results[rank];
+      online_max = std::max(online_max, r.online_ms);
+      verify_max = std::max(verify_max, r.verify_ms);
+      std::cout << (native_aby3 ? "aby3-boolean," : "spdzwise-abfl,") << kWidth
+                << ',' << kDepth << ',' << kWidth * kDepth << ',' << kBits
+                << ',' << (native_aby3 ? 0 : AbflBucketSize(kWidth * kDepth))
+                << ',' << iteration << ',' << rank << ',' << r.online_ms << ','
+                << r.verify_ms << ',' << r.online_ms + r.verify_ms << ','
+                << r.online_bytes << ',' << r.verify_bytes << ","
+                << (native_aby3 ? 0 : 1) << "\n";
+    }
+    std::cout.flush();
+    std::cerr << "iteration " << iteration
+              << (iteration == 0 ? " (warmup)" : "")
+              << ": online_max_ms=" << online_max
+              << ", verify_max_ms=" << verify_max << "; checked all " << kWidth
+              << " outputs\n";
+  }
+}
+}  // namespace
+}  // namespace spu::mpc::spdzwise
+
+int main(int argc, char** argv) {
+  SPU_ENFORCE(argc == 1 || (argc == 2 && std::string_view(argv[1]) == "--aby3"),
+              "usage: binary_bench [--aby3]");
+  spu::mpc::spdzwise::Run(argc == 2);
+}
diff --git a/src/libspu/mpc/spdzwise/benchmarks/run_binary.py b/src/libspu/mpc/spdzwise/benchmarks/run_binary.py
new file mode 100644
index 00000000..e8b16345
--- /dev/null
+++ b/src/libspu/mpc/spdzwise/benchmarks/run_binary.py
@@ -0,0 +1,178 @@
+"""Run the ABFL C2 benchmark and archive raw samples, provenance and statistics.
+
+Build //:binary_bench in this benchmark workspace first, then run:
+  python3 run_binary.py NEW_OUTPUT_DIRECTORY [--aby3]
+An existing directory containing only build.log is also accepted.
+"""
+import csv
+import hashlib
+import json
+import os
+import platform
+import statistics
+import subprocess
+import sys
+import time
+from datetime import datetime
+from pathlib import Path
+from zoneinfo import ZoneInfo
+
+BENCH = Path(__file__).resolve().parent
+ROOT = BENCH.parents[4]
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    if len(sys.argv) not in (2, 3) or (len(sys.argv) == 3 and sys.argv[2] != "--aby3"):
+        raise SystemExit("usage: run_binary.py NEW_OUTPUT_DIRECTORY [--aby3]")
+    native = len(sys.argv) == 3
+    protocol = "aby3-boolean" if native else "spdzwise-abfl"
+    checks = 0 if native else 1
+    bucket = 0 if native else 3
+    out = Path(sys.argv[1]).resolve()
+    out.mkdir(parents=True, exist_ok=True)
+    if any(p.name != "build.log" for p in out.iterdir()):
+        raise SystemExit("Refusing to overwrite an existing experiment")
+    binary = BENCH / "bazel-bin/binary_bench"
+    sources = sorted((BENCH.parent).glob("*.cc")) + sorted((BENCH.parent).glob("*.h"))
+    sources += [BENCH.parent / "BUILD.bazel"]
+    sources += [BENCH / n for n in ("binary_bench.cc", "BUILD.bazel", "MODULE.bazel", "MODULE.bazel.lock", ".bazelrc", "run_binary.py")]
+    sources += [ROOT / "src" / path for path in (
+        "libspu/mpc/aby3/boolean.cc", "libspu/mpc/aby3/type.h",
+        "libspu/mpc/common/communicator.h", "libspu/mpc/common/prg_state.cc",
+        "libspu/core/parallel_utils.h")]
+    parameters = {
+        "started_at": datetime.now(ZoneInfo("Asia/Shanghai")).isoformat(),
+        "protocol": protocol, "width": 65536, "depth": 16,
+        "word_ands": 1048576, "bit_ands": 67108864, "nbits": 64,
+        "bucket_size": bucket, "verification_unit": "none" if native else "64-bit word", "cut_and_choose_words": 0 if native else 3,
+        "cut_and_choose_bits": 0 if native else 192, "random_word_triples": 0 if native else 2097155,
+        "random_bit_triples": 0 if native else 134217920,
+        "input_vectors": 17, "secret_input_words": 1114112,
+        "input_generator": "SplitMix64 finalizer(index + 0x9e3779b97f4a7c15), index=layer*65536+i; see source",
+        "circuit": "z[0,i]=x[0,i]; z[l+1,i]=z[l,i]&x[l+1,i]",
+        "tiling": False, "warmups": 1, "repetitions": 7,
+        "verification_tile_words": 0 if native else 65536,
+        "random_generation_tile_words": 0 if native else 65536,
+        "replica_check_tile_words": 0 if native else 65536,
+        "replica_check": "none" if native else "BLAKE3-256 per tile, sent only to replica holder",
+        "transport": "FactoryMem, three parties in one process",
+        "timing": "native ABY3 AND, PRSS masks and communication only" if native else "online includes AND, PRSS masks and saved triples; verification includes random triple generation, copy checks, commit-reveal, cut-and-choose and sacrifice",
+        "excluded": "input sharing, runtime/PRSS setup, input import/copy checks, output export/reconstruction and plaintext comparison",
+        "aggregation": "per repetition take maximum over parties for each phase; total=sum of phase maxima; report median/min/max over seven repetitions excluding warmup",
+        "platform": platform.platform(), "logical_cpus": os.cpu_count(),
+        "cpu_affinity": sorted(os.sched_getaffinity(0)),
+        "loadavg_at_start": os.getloadavg(),
+        "YACL_NUM_THREADS": os.environ.get("YACL_NUM_THREADS"),
+        "compiler": subprocess.check_output(["c++", "--version"], text=True).splitlines()[0],
+        "build": "Bazel 7.7.1, -c opt; see build.log",
+        "git_revision": subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip(),
+        "git_status": subprocess.check_output(["git", "status", "--short"], cwd=ROOT, text=True),
+        "binary_sha256": digest(binary),
+        "source_sha256": {str(p.relative_to(ROOT)): digest(p) for p in sources},
+    }
+    (out / "parameters.json").write_text(json.dumps(parameters, indent=2) + "\n")
+    (out / "lscpu.txt").write_text(subprocess.check_output(["lscpu"], text=True))
+    (out / "meminfo.txt").write_text(Path("/proc/meminfo").read_text())
+    (out / "run_binary.py").write_bytes(Path(__file__).read_bytes())
+    # Archive executable inputs only, not old experiment data or report edits.
+    patch = subprocess.check_output(
+        ["git", "diff", "--binary", "HEAD", "--"] +
+        [str(p.relative_to(ROOT)) for p in sources], cwd=ROOT)
+    for path in sources:
+        tracked = subprocess.run(["git", "ls-files", "--error-unmatch", str(path.relative_to(ROOT))], cwd=ROOT, capture_output=True)
+        if tracked.returncode:
+            diff = subprocess.run(["git", "diff", "--no-index", "--", "/dev/null", str(path.relative_to(ROOT))], cwd=ROOT, capture_output=True)
+            if diff.returncode != 1:
+                raise RuntimeError(diff.stderr.decode())
+            patch += diff.stdout
+    (out / "source.patch").write_bytes(patch)
+    start = time.monotonic()
+    with (out / "w65536-d16.stdout").open("w") as stdout, (out / "w65536-d16.log").open("w") as stderr:
+        process = subprocess.Popen([str(binary)] + (["--aby3"] if native else []), stdout=stdout, stderr=stderr)
+        _, status, usage = os.wait4(process.pid, 0)
+        process.returncode = os.waitstatus_to_exitcode(status)
+    resources = {
+        "exit_code": process.returncode, "wall_seconds": time.monotonic() - start,
+        "user_seconds": usage.ru_utime, "system_seconds": usage.ru_stime,
+        "max_rss_kib": usage.ru_maxrss, "loadavg_at_end": os.getloadavg(),
+        "finished_at": datetime.now(ZoneInfo("Asia/Shanghai")).isoformat(),
+    }
+    (out / "resources.json").write_text(json.dumps(resources, indent=2) + "\n")
+    if process.returncode:
+        raise SystemExit(f"Benchmark failed ({process.returncode}); see archived logs")
+    lines = [s for s in (out / "w65536-d16.stdout").read_text().splitlines(True)
+             if s.startswith(("protocol,", protocol + ","))]
+    (out / "w65536-d16.csv").write_text("".join(lines))
+    rows = list(csv.DictReader(lines))
+    assert len(rows) == 24
+    maxima = []
+    for iteration in range(8):
+        batch = [r for r in rows if int(r["iteration"]) == iteration]
+        assert len(batch) == 3 and {int(r["rank"]) for r in batch} == {0, 1, 2}
+        for r in batch:
+            for key, value in {"width":65536, "depth":16, "word_ands":1048576,
+                               "bit_ands":67108864, "bucket_size":bucket,
+                               "online_bytes":8388608, "verify_bytes":0 if native else 218110266,
+                               "checks":checks}.items():
+                assert int(r[key]) == value, (key, r)
+            assert abs(float(r["total_ms"]) - float(r["online_ms"]) - float(r["verify_ms"])) < 0.00001
+        online, verify = [max(float(r[key]) for r in batch) for key in ("online_ms", "verify_ms")]
+        if iteration:
+            maxima.append({"iteration":iteration, "online_ms":online,
+                           "verify_ms":verify, "total_ms":online+verify})
+    payloads = {key: {int(r[key]) for r in rows} for key in ("online_bytes", "verify_bytes")}
+    assert all(len(v) == 1 for v in payloads.values())
+    summary = {"aggregation":parameters["aggregation"], "iterations":maxima,
+               "phases":{key:{"median_ms":statistics.median(r[key] for r in maxima),
+                              "min_ms":min(r[key] for r in maxima),
+                              "max_ms":max(r[key] for r in maxima)}
+                         for key in ("online_ms", "verify_ms", "total_ms")},
+               "bytes_per_party":{k:next(iter(v)) for k,v in payloads.items()},
+               "validated_output_words_per_iteration":65536, "validated_iterations":8}
+    (out / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")
+    (out / "summary.txt").write_text(json.dumps(summary["phases"], indent=2) + "\n")
+    phase = summary["phases"]
+    comm = summary["bytes_per_party"]
+    title = "ABY3 Boolean" if native else "SPDZwise-ABFL word64"
+    verification = ("原生 ABY3 半诚实 AND，无最终 verification，也不保存 triple。输入使用同一 XOR replicated sharing 布局，在计时外适配为 ABY3 Boolean 类型。" if native else
+                    "B=3，随机 triple 2,097,155 个 64-bit word（134,217,920 bit lanes）。置换、分桶和抽查均以 word 为单位；抽查 3 个随机 word，B 按在线 packed word 数选择。")
+    report = f'''# {title} C2 — {parameters["started_at"].split("T")[0]}
+
+三方 FactoryMem 本机实验；W=65,536，D=16，64-bit packed AND，电路不分块。
+YACL_NUM_THREADS={parameters["YACL_NUM_THREADS"] or "默认"}；ABFL verification 使用 65,536-word 工作块。
+共 1,048,576 个 word AND / 67,108,864 个 bit AND。
+{verification}
+预热 1 次，正式测量 7 次；每轮各阶段取三方最大耗时，再取七轮中位数。
+总耗时按每轮的 online 最大值与 verification 最大值相加后统计。
+
+| 阶段 | 中位数 ms | 最小 ms | 最大 ms | 每方发送 payload bytes |
+|---|---:|---:|---:|---:|
+| Online AND{"（含保存 triple）" if not native else ""} | {phase['online_ms']['median_ms']:.3f} | {phase['online_ms']['min_ms']:.3f} | {phase['online_ms']['max_ms']:.3f} | {comm['online_bytes']} |
+| Final verification | {phase['verify_ms']['median_ms']:.3f} | {phase['verify_ms']['min_ms']:.3f} | {phase['verify_ms']['max_ms']:.3f} | {comm['verify_bytes']} |
