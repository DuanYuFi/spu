+
+namespace spu::mpc::spdzwise::ring {
+
+// Reuse the external metadata grammar, but never the FIELD type identity.
+class InputTy final : public TypeImpl<InputTy, TypeObject, Secret, AShare> {
+  spdzwise::InputTy metadata_;
+
+ public:
+  InputTy() = default;
+  explicit InputTy(size_t rank) : metadata_(rank) {}
+  static std::string_view getStaticId() { return "spdzwise.ring.Input"; }
+  size_t rank() const { return metadata_.rank(); }
+  size_t size() const override { return sizeof(RepShare); }
+  std::string toString() const override { return metadata_.toString(); }
+  void fromString(std::string_view detail) override {
+    metadata_.fromString(detail);
+  }
+  bool equals(const TypeObject* other) const override {
+    const auto* typed = dynamic_cast<const InputTy*>(other);
+    return typed && metadata_.equals(&typed->metadata_);
+  }
+};
+
+// FM64 is the application width; all four internal components are 128 bits.
+class AShrTy final
+    : public TypeImpl<AShrTy, TypeObject, Ring2k, Secret, AShare> {
+  std::string session_;
+
+ public:
+  AShrTy() { field_ = FM64; }
+  explicit AShrTy(std::string session) : session_(std::move(session)) {
+    SPU_ENFORCE(!session_.empty(), "SPDZWISE requires a session identity");
+    field_ = FM64;
+  }
+  static std::string_view getStaticId() { return "spdzwise.ring.AShr"; }
+  const std::string& session() const { return session_; }
+  size_t size() const override { return sizeof(AuthShare); }
+  bool isSerializable() const override { return false; }
+  std::string toString() const override { return session_; }
+  void fromString(std::string_view) override {
+    SPU_THROW("SPDZWISE ring authentication cannot be imported from clients");
+  }
+  bool equals(const TypeObject* other) const override {
+    const auto* typed = dynamic_cast<const AShrTy*>(other);
+    return typed && session_ == typed->session_;
+  }
+};
+
+// Only the low 64 bits of each value component leave the checked session.
+class OutputTy final : public TypeImpl<OutputTy, TypeObject, Secret, AShare> {
+  spdzwise::OutputTy metadata_;
+
+ public:
+  OutputTy() = default;
+  OutputTy(size_t rank, std::string binding)
+      : metadata_(rank, std::move(binding)) {}
+  static std::string_view getStaticId() { return "spdzwise.ring.Output"; }
+  size_t rank() const { return metadata_.rank(); }
+  const std::string& binding() const { return metadata_.binding(); }
+  size_t size() const override { return sizeof(spdzwise::RepShare); }
+  std::string toString() const override { return metadata_.toString(); }
+  void fromString(std::string_view detail) override {
+    metadata_.fromString(detail);
+  }
+  bool equals(const TypeObject* other) const override {
+    const auto* typed = dynamic_cast<const OutputTy*>(other);
+    return typed && metadata_.equals(&typed->metadata_);
+  }
+};
+
+}  // namespace spu::mpc::spdzwise::ring
diff --git a/src/libspu/mpc/spdzwise/benchmarks/ring_circuit_bench.cc b/src/libspu/mpc/spdzwise/benchmarks/ring_circuit_bench.cc
new file mode 100644
index 00000000..5d05e6b4
--- /dev/null
+++ b/src/libspu/mpc/spdzwise/benchmarks/ring_circuit_bench.cc
@@ -0,0 +1,181 @@
+// Copyright 2026 The SPU Authors. All Rights Reserved.
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+// http://www.apache.org/licenses/LICENSE-2.0
+
+#include <chrono>
+#include <condition_variable>
+#include <iomanip>
+#include <iostream>
+#include <limits>
+#include <mutex>
+
+#include "libspu/mpc/api.h"
+#include "libspu/mpc/common/pv2k.h"
+#include "libspu/mpc/spdzwise/field.h"
+#include "libspu/mpc/spdzwise/io.h"
+#include "libspu/mpc/spdzwise/protocol.h"
+#include "libspu/mpc/spdzwise/state.h"
+#include "libspu/mpc/utils/simulate.h"
+
+namespace spu::mpc::spdzwise {
+namespace {
+class Barrier {
+  std::mutex mutex_;
+  std::condition_variable cv_;
+  size_t arrived_ = 0;
+  size_t generation_ = 0;
+
+ public:
+  void wait() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    const auto generation = generation_;
+    if (++arrived_ == 3) {
+      arrived_ = 0;
+      ++generation_;
+      cv_.notify_all();
+    } else {
+      cv_.wait(lock, [&] { return generation_ != generation; });
+    }
+  }
+};
+using Clock = std::chrono::steady_clock;
+double Milliseconds(Clock::time_point start) {
+  return std::chrono::duration<double, std::milli>(Clock::now() - start)
+      .count();
+}
+struct Result {
+  // Normal input import (including its immediate check), local expansion,
+  // circuit (add + multiply + saved check records), final MAC check.
+  std::array<double, 4> ms{};
+  std::array<size_t, 4> bytes{};
+  double mul_ms = 0;
+  NdArrayRef output;
+};
+
+void Run(int64_t width, int64_t depth, int repetitions, bool ring = true) {
+  const auto gates = width * depth;
+  RuntimeConfig config(SPDZWISE, FM64);
+  config.spdzwise_config.domain =
+      ring ? SpdzWiseConfig::RING : SpdzWiseConfig::FIELD;
+  config.fxp_fraction_bits = 16;
+  SpdzWiseIo io(FM64, 3, config.spdzwise_config.domain);
+  NdArrayRef plain(makeType<RingTy>(FM64), {2});
+  // Same raw input words and recurrence as the existing arithmetic benchmark.
+  plain.data<uint64_t>()[0] = (uint64_t{1} << 60) - 8;
+  plain.data<uint64_t>()[1] = uint64_t(-13);
+  const auto inputs = io.toShares(plain, VIS_SECRET);
+  NdArrayRef offsets(makeType<Pub2kTy>(FM64), {width});
+  std::vector<uint64_t> expected(width);
+  for (int64_t i = 0; i < width; ++i) {
+    offsets.data<uint64_t>()[i] = i;
+    auto x = ring ? plain.data<uint64_t>()[0] + uint64_t(i)
+                  : Add(FromRing(plain.data<uint64_t>()[0]), i);
+    for (int64_t layer = 0; layer < depth; ++layer) {
+      x = ring ? x * (x + plain.data<uint64_t>()[1])
+               : Mul(x, Add(x, FromRing(plain.data<uint64_t>()[1])));
+    }
+    expected[i] = ring ? x : ToRing(x);
+  }
+  std::cout << std::fixed << std::setprecision(6)
+            << "protocol,width,depth,gates,secret_inputs,iteration,rank,"
+               "input_ms,expand_ms,circuit_ms,verify_ms,mul_ms,"
+               "input_bytes,expand_bytes,circuit_bytes,verify_bytes,checks\n";
+  // A new session each iteration; setup and checked export are outside timing.
+  // Iteration zero is the warmup, retained in CSV but excluded from statistics.
+  for (int iteration = 0; iteration <= repetitions; ++iteration) {
+    Barrier barrier;
+    const auto results = utils::simulate(3, [&](const auto& link) {
+      SPUContext ctx(config, link);
+      registerArithmeticPrototype(&ctx, link);
+      auto* state = ctx.prot()->getState<SpdzWiseState>();
+      ProtocolRunGuard guard(&ctx);
+      Value original(inputs[link->Rank()], DT_I64);
+      state->begin(ExecutableProto("ring_circuit_bench", {"xy"}, {"z"}, "test"),
+                   {original});
+      const auto checks = state->arithmeticChecks();
+      const auto stats = link->GetStats();
+      Result result;
+      auto phase = [&](size_t index, auto&& fn) {
+        barrier.wait();
+        const auto bytes = stats->sent_bytes.load();
+        const auto start = Clock::now();
+        fn();
+        result.ms[index] = Milliseconds(start);
+        result.bytes[index] = stats->sent_bytes.load() - bytes;
+      };
+      Value authenticated, z, y;
+      phase(0, [&] { authenticated = import_s(&ctx, original); });
+      SPU_ENFORCE(state->arithmeticChecks() == checks + 1);
+      phase(1, [&] {
+        z = dynDispatch(&ctx, "extract_slice", authenticated, Index{0},
+                        Index{1}, Strides{1});
+        y = dynDispatch(&ctx, "extract_slice", authenticated, Index{1},
+                        Index{2}, Strides{1});
+        z = dynDispatch(&ctx, "broadcast", z, Shape{width}, Axes{0});
+        y = dynDispatch(&ctx, "broadcast", y, Shape{width}, Axes{0});
+        z = dynDispatch(&ctx, "add_ap", z, Value(offsets, DT_I64));
+      });
+      phase(2, [&] {
+        for (int64_t layer = 0; layer < depth; ++layer) {
+          const auto rhs = dynDispatch(&ctx, "add_aa", z, y);
+          const auto start = Clock::now();
+          z = dynDispatch(&ctx, "mul_aa", z, rhs);
+          result.mul_ms += Milliseconds(start);
+        }
+      });
+      SPU_ENFORCE(state->arithmeticChecks() == checks + 1,
+                  "unexpected check within the circuit");
+      phase(3, [&] { state->check(); });
+      SPU_ENFORCE(state->arithmeticChecks() == checks + 2);
+      // Per-party payloads: each resharing sends two 128-bit words per gate,
+      // plus two all-gather status rounds (4 bytes) per layer. Verification
+      // includes batch size, record copies, secret aggregation and Protocol 9.
+      SPU_ENFORCE(result.bytes[0] == (ring ? 242 : 96) && result.bytes[1] == 0);
+      SPU_ENFORCE(result.bytes[2] == size_t(gates) * (ring ? 32 : 16) +
+                                         (ring ? size_t(depth) * 4 : 0));
+      SPU_ENFORCE(result.bytes[3] ==
+                  (ring ? 168 + 2 * std::to_string(gates).size() : 64));
+      z.setDtype(DT_I64);
+      state->prepareOutputs(&ctx, {"z"}, {z});
+      guard.commit();
+      SPU_ENFORCE(state->arithmeticChecks() == checks + 2,
+                  "unexpected nonempty check at export");
+      result.output = state->exportedValue("z").data();
+      return result;
+    });
+    std::vector<NdArrayRef> outputs;
+    for (const auto& result : results) outputs.push_back(result.output);
+    const auto reconstructed = io.fromShares(outputs);
+    const NdArrayView<uint64_t> actual(reconstructed);
+    for (int64_t i = 0; i < width; ++i) {
+      SPU_ENFORCE(actual[i] == expected[i],
+                  "wrong output at iteration {}, index {}", iteration, i);
+    }
+    std::cerr << "iteration " << iteration << ": checked all " << width
+              << " outputs; " << gates << " multiplication gates\n";
+    for (size_t rank = 0; rank < results.size(); ++rank) {
+      const auto& result = results[rank];
+      std::cout << (ring ? "spdzwise-ring128," : "spdzwise-f61-normal,")
+                << width << ',' << depth << ',' << gates << ",2," << iteration
+                << ',' << rank;
+      for (const auto ms : result.ms) std::cout << ',' << ms;
+      std::cout << ',' << result.mul_ms;
+      for (const auto bytes : result.bytes) std::cout << ',' << bytes;
+      std::cout << ",2\n";
+    }
+  }
+}
+}  // namespace
+}  // namespace spu::mpc::spdzwise
+
+int main(int argc, char** argv) {
+  SPU_ENFORCE(argc == 4 || (argc == 5 && std::string(argv[4]) == "f61"),
+              "usage: ring_circuit_bench width depth repetitions [f61]");
+  const int64_t width = std::stoll(argv[1]), depth = std::stoll(argv[2]);
+  const int repetitions = std::stoi(argv[3]);
+  SPU_ENFORCE(width > 0 && depth > 0 && repetitions > 0 &&
+              width <= std::numeric_limits<int64_t>::max() / depth);
+  spu::mpc::spdzwise::Run(width, depth, repetitions, argc == 4);
+}
diff --git a/src/libspu/mpc/spdzwise/benchmarks/run_ring.py b/src/libspu/mpc/spdzwise/benchmarks/run_ring.py
new file mode 100644
index 00000000..9d82b826
--- /dev/null
+++ b/src/libspu/mpc/spdzwise/benchmarks/run_ring.py
@@ -0,0 +1,134 @@
+"""Benchmark RING SPDZWISE C1-C3, preserving raw data and source provenance.
+
+Build //:ring_circuit_bench first, then:
+  YACL_NUM_THREADS=12 python3 run_ring.py NEW_OUTPUT_DIRECTORY
+An existing output directory containing only build.log is also accepted.
+"""
+
+import csv
+import hashlib
+import json
+import os
+import platform
+import statistics
+import subprocess
+import sys
+import time
+from datetime import datetime
+from pathlib import Path
+from zoneinfo import ZoneInfo
+
+BENCH = Path(__file__).resolve().parent
+ROOT = BENCH.parents[4]
+CIRCUITS = {"C1": (1048576, 1), "C2": (65536, 16), "C3": (16384, 64)}
+PHASES = ("input_ms", "expand_ms", "circuit_ms", "verify_ms", "mul_ms")
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: run_ring.py NEW_OUTPUT_DIRECTORY")
+    out = Path(sys.argv[1]).resolve()
+    out.mkdir(parents=True, exist_ok=True)
+    if any(p.name != "build.log" for p in out.iterdir()):
+        raise SystemExit("Refusing to overwrite an existing experiment")
+    binary = BENCH / "bazel-bin/ring_circuit_bench"
+    sources = sorted(p for p in BENCH.parent.glob("*.cc") if not p.name.endswith("_test.cc"))
+    sources += sorted(BENCH.parent.glob("*.h"))
+    sources += [BENCH.parent / "BUILD.bazel"]
+    sources += [BENCH / n for n in ("ring_circuit_bench.cc", "run_ring.py", "BUILD.bazel", "MODULE.bazel", ".bazelrc")]
+    sources += [ROOT / "src" / n for n in ("libspu/mpc/protocol_session.cc", "libspu/mpc/common/prg_state.cc", "libspu/mpc/utils/simulate.h", "MODULE.bazel", ".bazelrc")]
+    parameters = {
+        "started_at": datetime.now(ZoneInfo("Asia/Shanghai")).isoformat(),
+        "protocol": "SPDZWISE + FM64 + RING", "internal_bits": 128,
+        "output_bits": 64, "extension_bits": 64, "check_zero": "Protocol 9, BLAKE3-256",
+        "circuits": CIRCUITS, "gates": 1048576, "secret_input_words": 2,
+        "inputs": "x=2^60-8, y=uint64(-13)",
+        "recurrence": "z[0,i]=x+i; z[l+1,i]=z[l,i]*(z[l,i]+y)",
+        "warmups": 1, "repetitions": 7, "fresh_session_per_iteration": True,
+        "checks_per_iteration": "one immediate input check, one final check of all 1048576 products",
+        "transport": "FactoryMem: three parties in one process",
+        "excluded": "client sharing, context/session/key/PRSS initialization, barriers, checked export/commit, reconstruction and plaintext oracle",
+        "included": "input includes copy check, MAC generation and immediate verification; circuit includes secret additions, multiplications, PRSS masks, communication and saved verification records; verification includes copy checks, secret-coefficient aggregation, Protocol 9 and status propagation",
+        "aggregation": "per iteration take the maximum over parties for each phase; core=circuit+verify, total=input+expand+core; report median/min/max over iterations 1..7 (exclude warmup 0)",
+        "communication": "sent payload bytes per party; excludes transport headers and untimed setup/export",
+        "YACL_NUM_THREADS": os.environ.get("YACL_NUM_THREADS"),
+        "platform": platform.platform(), "logical_cpus": os.cpu_count(),
+        "cpu_affinity": sorted(os.sched_getaffinity(0)), "loadavg_at_start": os.getloadavg(),
+        "compiler": subprocess.check_output(["c++", "--version"], text=True).splitlines()[0],
+        "git_revision": subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip(),
+        "binary_sha256": digest(binary),
+        "source_sha256": {str(p.relative_to(ROOT)): digest(p) for p in sources},
+    }
+    (out / "parameters.json").write_text(json.dumps(parameters, indent=2) + "\n")
+    (out / "lscpu.txt").write_text(subprocess.check_output(["lscpu"], text=True))
+    patch = subprocess.check_output(["git", "diff", "--binary", "HEAD", "--"] + [str(p.relative_to(ROOT)) for p in sources], cwd=ROOT)
+    for path in sources:
+        relative = str(path.relative_to(ROOT))
+        tracked = subprocess.run(["git", "ls-files", "--error-unmatch", relative], cwd=ROOT, capture_output=True)
+        if tracked.returncode:
+            diff = subprocess.run(["git", "diff", "--no-index", "--", "/dev/null", relative], cwd=ROOT, capture_output=True)
+            if diff.returncode != 1:
+                raise RuntimeError(diff.stderr.decode())
+            patch += diff.stdout
+    (out / "source.patch").write_bytes(patch)
+    summaries = {}
+    for name, (width, depth) in CIRCUITS.items():
+        command = [str(binary), str(width), str(depth), "7"]
+        start = time.monotonic()
+        with (out / f"{name}.stdout").open("w") as stdout, (out / f"{name}.log").open("w") as stderr:
+            process = subprocess.Popen(command, stdout=stdout, stderr=stderr)
+            _, status, usage = os.wait4(process.pid, 0)
+            process.returncode = os.waitstatus_to_exitcode(status)
+        resource = {
+            "command": command, "exit_code": process.returncode,
+            "wall_seconds": time.monotonic() - start,
+            "user_seconds": usage.ru_utime, "system_seconds": usage.ru_stime,
+            "max_rss_kib": usage.ru_maxrss, "loadavg_at_end": os.getloadavg(),
+        }
+        (out / f"{name}-resources.json").write_text(json.dumps(resource, indent=2) + "\n")
+        if process.returncode:
+            raise SystemExit(f"{name} failed; see {name}.log")
+        lines = [line for line in (out / f"{name}.stdout").read_text().splitlines(True)
+                 if line.startswith(("protocol,", "spdzwise-ring128,"))]
+        (out / f"{name}.csv").write_text("".join(lines))
+        rows = list(csv.DictReader(lines))
+        assert len(rows) == 24
+        measured = []
+        for iteration in range(8):
+            batch = [r for r in rows if int(r["iteration"]) == iteration]
+            assert len(batch) == 3 and {int(r["rank"]) for r in batch} == {0, 1, 2}
+            for row in batch:
+                for key, value in {"width": width, "depth": depth, "gates":1048576,
+                                   "secret_inputs": 2, "checks": 2, "input_bytes":242,
+                                   "expand_bytes":0, "circuit_bytes":33554432+4*depth,
+                                   "verify_bytes":182}.items():
+                    assert int(row[key]) == value, (name, key, row)
+                assert float(row["mul_ms"]) <= float(row["circuit_ms"])
+            maximum = {key: max(float(r[key]) for r in batch) for key in PHASES}
+            maximum["core_ms"] = maximum["circuit_ms"] + maximum["verify_ms"]
+            maximum["total_ms"] = maximum["input_ms"] + maximum["expand_ms"] + maximum["core_ms"]
+            if iteration:
+                measured.append({"iteration": iteration, **maximum})
+        phases = {key: {"median_ms": statistics.median(r[key] for r in measured),
+                        "min_ms": min(r[key] for r in measured),
+                        "max_ms": max(r[key] for r in measured)}
+                  for key in (*PHASES, "core_ms", "total_ms")}
+        summaries[name] = {
+            "width": width, "depth": depth, "iterations": measured, "phases": phases,
+            "bytes_per_party": {key: int(rows[0][key]) for key in ("input_bytes", "expand_bytes", "circuit_bytes", "verify_bytes")},
+            "validated_iterations": 8, "validated_outputs_per_iteration": width,
+        }
+        print(name, json.dumps(phases), flush=True)
+    (out / "summary.json").write_text(json.dumps(summaries, indent=2) + "\n")
+    # Detect accidental edits or replacement of the executable during the run.
+    assert digest(binary) == parameters["binary_sha256"]
+    assert all(digest(ROOT / name) == sha for name, sha in parameters["source_sha256"].items())
+    (out / "SHA256SUMS").write_text("".join(f"{digest(p)}  {p.name}\n" for p in sorted(out.iterdir()) if p.is_file()))
+
+
+if __name__ == "__main__":
+    main()
